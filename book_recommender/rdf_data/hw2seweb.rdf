    </bk:hasReadingLevel>
    <bk:prefersTheme>
      <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ursal/ontologies/2025/4/untitled-ontology-2#MysteryTheme">
        <rdf:type rdf:resource="http://www.semanticweb.org/ursal/ontologies/2025/4/untitled-ontology-2#Theme"/>
        <bk:themeName>Mystery</bk:themeName>
      </owl:NamedIndividual>
    </bk:prefersTheme>
    <bk:userName>Bob</bk:userName>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ursal/ontologies/2025/4/untitled-ontology-2#themeName">
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ursal/ontologies/2025/4/untitled-ontology-2#Theme"/>
