    <rdfs:range rdf:resource="http://www.semanticweb.org/ursal/ontologies/2025/4/untitled-ontology-2#Theme"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/ursal/ontologies/2025/4/untitled-ontology-2#levelName">
