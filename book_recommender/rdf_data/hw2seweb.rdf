  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ursal/ontologies/2025/4/untitled-ontology-2#Dune">
    <rdf:type rdf:resource="http://www.semanticweb.org/ursal/ontologies/2025/4/untitled-ontology-2#Book"/>
